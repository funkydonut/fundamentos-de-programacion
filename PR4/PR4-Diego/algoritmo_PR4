{Constants for file reading and limits}
const
    MAX_FILE_NAME: integer = 101;
    MAX_LINE: integer = 514;
    MAX_NAME_LENGTH: integer = 26;
    SECTORS_PER_NODE: integer = 5;
    MAX_NODES: integer = 20;

    {Constants for conversion and thresholds}
    MW_FACTOR: real = 0.001;
    CRITICAL_SECTOR_LIMIT: real = 150.0;
    STABILITY_INDEX_THRESHOLD: real = 120.0;
    MAX_UNSTABLE_SECTORS: integer = 3;
    VOLTAGE_DROP_THRESHOLD: real = 10.0;

    {Maintenance Thresholds}
    {...}
end const

{User defined types}
type
    tSectorType = {INDUSTRY, RESIDENTIAL, TRANSPORT, SERVICES, SANITARY};
    tPowerScale = {KW, MW};

    tSectorData = record
        sectorType: tSectorType;
        scale: tPowerScale;
        consumption: real;
        voltageDrop: real;
        stabilityIndex: real;
    end record

    tGridNode = record
        nodeName: string;
        sectors: vector[SECTORS_PER_NODE] of tSectorData;
        hasOverload: boolean;
        hasVoltageEmergency: boolean;
        hasStabilityWarnings: boolean;
    end record

    tGridTable = record
        nodes: vector[MAX_NODES] of tGridNode;
        nNodes: integer;
    end record

    tGridStats = record
        totalNodes: integer; {Total number of nodes in the grid}
        emergencyPercentage: real; {Percentage of nodes in emergency status}
        totalConsumption: real; {Total energy consumption of the network}
        maxVoltageDrop: real; {Maximum voltage drop detected}
        nodeWithMaxVoltageDrop: string; {Name of the node with maximum voltage drop}
        maxNodeConsumption: real; {Consumption value of the most demanding node}
        nodeWithMaxConsumption: string; {Name of the node with maximum consumption}
    end record
end type

{Reads grid data from a specified text file and populates the grid table.}
action loadGridDataFromFile(in filename: string, in scale: tPowerScale,
                            out gridTable: tGridTable, out isRead: boolean)
    var
        fileToRead: file;
        newNode: tGridNode;
        i: integer;
        consumption: real;
        sectorDataTmp: tSectorData;
    end var

    {Open the specified file for reading}
    fileToRead := openFile(filename);
    if fileToRead ≠ NULL then
        gridTable.nNodes := 0;
        {Read file line by line until EOF or maximum nodes reached}
        while not isEndOfFile(fileToRead) and gridTable.nNodes < MAX_NODES do
            {Process lines that are not empty}
            newNode.nodeName := readStringFromFile(fileToRead);
            {Parse data for each sector}
            for i := 1 to SECTORS_PER_NODE do
                sectorDataTmp.sectorType := readEnumFromFile(fileToRead);
                consumption := readRealFromFile(fileToRead);
                sectorDataTmp.voltageDrop := readRealFromFile(fileToRead);
                sectorDataTmp.stabilityIndex := readRealFromFile(fileToRead);
                sectorDataTmp.scale := scale;
                {Convert consumption if scale is MW}
                if sectorDataTmp.scale = MW then
                    sectorDataTmp.consumption := kwToMw(consumption);
                else
                    sectorDataTmp.consumption := consumption;
                end if
                newNode.sectors[i] := sectorDataTmp;
            end for
            {Store the parsed node in the table}
            gridTable.nodes[gridTable.nNodes + 1] := newNode;
            gridTable.nNodes := gridTable.nNodes + 1;
        end while
        closeFile(fileToRead);
        isRead := true;
    else
        isRead := false;
    end if
end action

{Exercise 2.1}
function isNodeStable(node: tGridNode): boolean
    var
        i: integer;
        nSectorsUnstable: integer;
        isStable: boolean;
    end var

    i := 1;
    nSectorsUnstable := 0;
    isStable := true;
    while i ≤ SECTORS_PER_NODE and isStable do
        if node.sectors[i].stabilityIndex < STABILITY_INDEX_THRESHOLD then
            nSectorsUnstable := nSectorsUnstable + 1;
            if nSectorsUnstable ≥ MAX_UNSTABLE_SECTORS then
                isStable := false;
            end if
        end if
        i := i + 1;
    end while
    return isStable;
end function

function kwToMw(kw: real): real
    return kw * MW_FACTOR;
end function

{Exercise 2.2}
action evaluateCrisisStatus(in scale: tPowerScale, inout node: tGridNode)
    var
        i: integer;
        j: integer;
        hasConsecutiveOverload: boolean;
        hasVoltageEmergency: boolean;
        hasStabilityWarnings: boolean;
        normalizedCriticalSectorLimit: real;
    end var

    if scale = MW then
        normalizedCriticalSectorLimit := kwToMw(CRITICAL_SECTOR_LIMIT);
    else
        normalizedCriticalSectorLimit := CRITICAL_SECTOR_LIMIT;
    end if

    i := 1;
    hasConsecutiveOverload := false;
    while i ≤ SECTORS_PER_NODE - 1 and not hasConsecutiveOverload do
        if node.sectors[i].consumption > normalizedCriticalSectorLimit and
           node.sectors[i + 1].consumption > normalizedCriticalSectorLimit then
            hasConsecutiveOverload := true;
        end if
        i := i + 1;
    end while
    node.hasOverload := hasConsecutiveOverload;

    j := 1;
    hasVoltageEmergency := false;
    while j ≤ SECTORS_PER_NODE and not hasVoltageEmergency do
        if node.sectors[j].voltageDrop > VOLTAGE_DROP_THRESHOLD then
            hasVoltageEmergency := true;
        end if
        j := j + 1;
    end while
    node.hasVoltageEmergency := hasVoltageEmergency;

    hasStabilityWarnings := false;
    if not isNodeStable(node) then
        hasStabilityWarnings := true;
    end if
    node.hasStabilityWarnings := hasStabilityWarnings;
end action

{Exercise 3.1}
action insertOrderedNode(inout table: tGridTable, in node: tGridNode)
    var
        i: integer;
        j: integer;
    end var

    if table.nNodes < MAX_NODES then
        i := 1;
        while i ≤ table.nNodes and node.nodeName > table.nodes[i].nodeName do
            i := i + 1;
        end while
        for j := table.nNodes downto i do
            table.nodes[j + 1] := table.nodes[j];
        end for
        table.nodes[i] := node;
        table.nNodes := table.nNodes + 1;
    end if
end action

{Exercise 3.2}
action getNodesWithAlerts(in table: tGridTable, out alertTable: tGridTable)
    var
        i: integer;
    end var

    alertTable.nNodes := 0;
    i := 1;
    while i ≤ table.nNodes do
        if table.nodes[i].hasOverload or table.nodes[i].hasVoltageEmergency or
           table.nodes[i].hasStabilityWarnings then
            insertOrderedNode(alertTable, table.nodes[i]);
        end if
        i := i + 1;
    end while
end action

{Exercise 3.3}
action writeGridStatus(in alertTable: tGridTable)
    var
        i: integer;
    end var

    for i := 1 to alertTable.nNodes do
        writeString("NODE: ");
        writeString(alertTable.nodes[i].nodeName);
        writeString(" - FLAGS [OVERLOAD: ");
        writeInteger(alertTable.nodes[i].hasOverload);
        writeString(", VOLTAGE: ");
        writeInteger(alertTable.nodes[i].hasVoltageEmergency);
        writeString(", STABILITY: ");
        writeInteger(alertTable.nodes[i].hasStabilityWarnings);
        writeString("]");
    end for
end action

action printNodeData(in node: tGridNode)
end action

{Exercise 4.2}
action getNode(in alertTable: tGridTable, in nodeName: string, out nodeResult: tGridNode, out found: boolean)
    var
        i: integer;
    end var

    found := false;
    i := 1;
    while i ≤ alertTable.nNodes and not found do
        if alertTable.nodes[i].nodeName = nodeName then
            found := true;
            nodeResult := alertTable.nodes[i];
        end if
        i := i + 1;
    end while
end action

{Exercise 5.1}
action calculateGridStatistics(in table: tGridTable, out statistics: tGridStats)
    var
        tmpTable: tGridTable;
        i: integer;
        j: integer;
        tmpNodeMaxConsumption: real;
    end var

    statistics.totalConsumption := 0;
    statistics.maxVoltageDrop := 0;
    statistics.maxNodeConsumption := 0;
    statistics.totalNodes := table.nNodes;

    getNodesWithAlerts(table, tmpTable);
    if table.nNodes > 0 then
        statistics.emergencyPercentage := tmpTable.nNodes / table.nNodes * 100;
    else
        statistics.emergencyPercentage := 0;
    end if

    for i := 1 to table.nNodes do
        tmpNodeMaxConsumption := 0;
        for j := 1 to SECTORS_PER_NODE do
            statistics.totalConsumption := statistics.totalConsumption +
                                           table.nodes[i].sectors[j].consumption;
            if table.nodes[i].sectors[j].voltageDrop > statistics.maxVoltageDrop then
                statistics.maxVoltageDrop := table.nodes[i].sectors[j].voltageDrop;
                statistics.nodeWithMaxVoltageDrop := table.nodes[i].nodeName;
            end if
            tmpNodeMaxConsumption := tmpNodeMaxConsumption +
                                     table.nodes[i].sectors[j].consumption;
        end for
        if tmpNodeMaxConsumption > statistics.maxNodeConsumption then
            statistics.maxNodeConsumption := tmpNodeMaxConsumption;
            statistics.nodeWithMaxConsumption := table.nodes[i].nodeName;
        end if
    end for
end action

{Exercise 5.2}
action printGridStatistics(in statistics: tGridStats)
    writeString("TOTAL NODES: ");
    writeInteger(statistics.totalNodes);
    writeString("NODES IN ALERTS: ");
    writeReal(statistics.emergencyPercentage);
    writeString("%");
    writeString("TOTAL NETWORK CONSUMPTION: ");
    writeReal(statistics.totalConsumption);
    writeString("PEAK CONSUMPTION NODE: ");
    writeString(statistics.nodeWithMaxConsumption);
    writeString(" (");
    writeReal(statistics.maxNodeConsumption);
    writeString(")");
    writeString("MOST CRITICAL VOLTAGE DROP: ");
    writeReal(statistics.maxVoltageDrop);
    writeString(" AT NODE ");
    writeString(statistics.nodeWithMaxVoltageDrop);
end action

algorithm PR4_Smart_Grid_Crisis_Management_Solution
    var
        grid: tGridTable;
        scale: tPowerScale;
        crisisResultsTable: tGridTable;
        filename: string;
        isRead: boolean;
        nodeName: string;
        found: boolean;
        isValidScale: boolean;
        stats: tGridStats;
        nodeResult: tGridNode;
        i: integer;
    end var

    {Initializations}
    isRead := false;
    found := false;

    writeString("--- SMART GRID CRISIS MANAGEMENT SYSTEM PR4 ---");
    writeString("INPUT DATA");

    do
        writeString("SELECT POWER SCALE (1-KW, 2-MW) >>");
        scale := readEnum();
        isValidScale := (scale = KW) or (scale = MW);
        if not isValidScale then
            writeString("INVALID DATA, TRY AGAIN!");
        end if
    while not isValidScale;

    {Prompt user for filename and attempt to load data}
    writeString("LOAD DATA FROM FILE. ENTER FILE NAME >>");
    filename := readString();
    loadGridDataFromFile(filename, scale, grid, isRead);

    if isRead then
        {Exercises 2.x}
        i := 1;
        while i ≤ grid.nNodes do
            evaluateCrisisStatus(scale, grid.nodes[i]);
            i := i + 1;
        end while

        getNodesWithAlerts(grid, crisisResultsTable);
        writeString("RESULTS");
        writeString("NODES WITH ALERTS");
        writeString("=================");

        if crisisResultsTable.nNodes > 0 then
            writeGridStatus(crisisResultsTable);
            writeString("SELECT NODE BY NAME TO SEARCH >>");
            nodeName := readString();
            getNode(crisisResultsTable, nodeName, nodeResult, found);
            if not found then
                writeString("NODE IS NOT IN ALERTS LIST");
            else
                printNodeData(nodeResult);
            end if
        else
            writeString("NO ALERTS SITUATIONS");
        end if

        writeString("--- GLOBAL GRID STATISTICS ---");
        calculateGridStatistics(grid, stats);
        printGridStatistics(stats);
        writeString("------------------------------");
    else
        writeString("ERROR: NO DATA RECOVERED FROM FILE ");
        writeString(filename);
    end if
end algorithm
